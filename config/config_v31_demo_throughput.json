{
  "$schema": "./config_schema.json",
  "$extends": "config_v31.json",
  "version": "31.1.0",
  "app_version": "v31.1-demo-throughput",
  "_note": "DEMO ONLY — higher trade frequency for soak/learning. Do NOT use on LIVE.",
  "demo_throughput_mode": {
    "enabled": true,
    "bypass_execution_guards": true,
    "bypass_traffic_governor": true,
    "demo_max_tx_per_60s": 12,
    "unlimited_open_positions": true,
    "unlimited_daily_trades": true,
    "pierce_z_threshold": 1.5,
    "max_daily_trades": 0,
    "cooldown_seconds": 0,
    "cooldown_minutes_after_close": 0,
    "gate_eval_cooldown_sec": 5,
    "order_cadence_sec": 10,
    "stagnant_dead_zone_sec": 120,
    "z_short_window": 12
  },
  "pricing": {
    "yahoo_poll_sec": 5
  },
  "max_daily_trades": 0,
  "max_open_positions": 9999,
  "max_positions_per_epic": 9999,
  "one_position_per_epic": false,
  "cooldown_seconds": 0,
  "correlation_guard": {
    "max_open_positions_global": 9999,
    "max_concurrent_us_index_shorts": 9999
  },
  "entry_protection": {
    "cooldown_minutes_after_close": 0,
    "max_trades_per_epic_per_session": 0
  },
  "demo_soak_mode": {
    "enabled": true,
    "fitness_min": 48,
    "bypass_ml_veto": true,
    "require_points_healthy": false,
    "spread_to_atr_circuit_max": 15.0
  },
  "micro_lot_verification": {
    "enabled": false,
    "_note": "Spreadbet demo uses fractional canary lots (0.5 index / 1.0 gold) via resolve_executable_lot_size"
  },
  "dual_core": {
    "broker_account_product": "SPREADBET",
    "active_stack_slots": 3,
    "exclude_from_hot_path": [
      "CS.D.EURUSD.CFD.IP",
      "CS.D.GBPUSD.CFD.IP",
      "IX.D.DAX.IFM.IP",
      "CS.D.CRUDE.CFD.IP"
    ],
    "_note": "3 parallel markets: DOW + Nikkei + Gold when TRADEABLE; FX/DAX/Crude blocked on demo spreadbet"
  },
  "ig_deal_size_floors": {
    "_note": "Authoritative min £/pt — mirrored in execution/size_floors.py SPREADBET_MIN_DEAL_BY_EPIC",
    "CS.D.CFPGOLD.CFP.IP": 10.0,
    "IX.D.NIKKEI.IFM.IP": 0.5,
    "IX.D.DOW.IFM.IP": 0.5
  },
  "micro_risk": {
    "risk_per_trade_gbp": 5.0,
    "target_r_multiple": 1.5,
    "min_profit_target_pts": 1.0,
    "max_loss_cap_pts": 4.0,
    "virtual_stop_ceiling_pts": 4.0,
    "_note": "Replaces fixed 1.5/2.0pt stops that clustered Gold P&L at ±£20 (size×pts×$1/pt)"
  },
  "session_validation": {
    "clear_circuit_breaker_on_boot": true
  }
}
