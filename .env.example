# IG Agent v29.1 — headless credential context (copy to .env at project root)
# Never commit .env — it is gitignored.

# IG REST API credentials (required for boot + sandbox gate auth)
IG_USERNAME=your_ig_username
IG_PASSWORD=your_ig_password
IG_API_KEY=your_ig_api_key

# DEMO or LIVE
ACCOUNT_TYPE=DEMO

# CFD account id (e.g. Z6BAH4) — required alongside the keys above
IG_ACCOUNT_ID=Z6BAH4
