<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.igagent.gui_desk_supervisor</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON_BIN__</string>
		<string>__REPO_ROOT__/scripts/gui_desk_supervisor.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO_ROOT__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONPATH</key>
		<string>__REPO_ROOT__/src</string>
		<key>IG_AGENT_CONFIG</key>
		<string>config/config_v31_demo_throughput.json</string>
		<key>IG_DATA_ROOT</key>
		<string>__REPO_ROOT__/src/data/v31-production</string>
		<key>IG_AGENT_DATA_DIR</key>
		<string>__REPO_ROOT__/src/data/v31-production</string>
		<key>APP_MODE</key>
		<string>DEMO</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>StandardOutPath</key>
	<string>__REPO_ROOT__/src/data/v31-production/logs/gui_desk_supervisor.out.log</string>
	<key>StandardErrorPath</key>
	<string>__REPO_ROOT__/src/data/v31-production/logs/gui_desk_supervisor.err.log</string>
</dict>
</plist>
